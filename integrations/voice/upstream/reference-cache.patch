+/// Only model filenames and process memory counters enter the feasibility log.
+fn report_memory(stage: &str, path: &Path) {
+    let status = std::fs::read_to_string("/proc/self/status").unwrap_or_default();
+    let counters: Vec<_> = status.lines().filter(|line|
+        line.starts_with("VmRSS:") || line.starts_with("VmSize:") || line.starts_with("VmHWM:")
+    ).collect();
+    eprintln!("MODEL_MEMORY {} {:?} {}", stage, path.file_name(), counters.join("; "));
+}
