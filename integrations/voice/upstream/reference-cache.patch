+pub fn export_prepared_text(root: &Path, text: &str, destination: &Path) -> Result<(), GSVError> {
+    let mut processor = TextProcessor::new(
+        G2PW::new(Some(root.join("g2pW.onnx")))?,
+        G2pEn::new(Some(root.join("g2p_en")))?,
+        BertModel::new(Some(root.join("bert.onnx")))?,
+    )?;
+    let fragments = processor.get_phone_and_bert(&ensure_punctuation(text), LangId::Auto)?;
+    let prepared = PreparedText { schema_version: 1, text: text.to_owned(), fragments };
+    std::fs::write(destination, serde_json::to_vec(&prepared).map_err(|e| GSVError::from(e.to_string()))?)?;
+    Ok(())
