 impl TTSModel {
+    fn process_text(&mut self, text: &str, lang_id: LangId) -> Result<Vec<(String, Vec<i64>, Array2<f32>)>, GSVError> {
+        if let Some(processor) = self.text_processor.as_mut() {
+            return Ok(processor.get_phone_and_bert(text, lang_id)?);
+        }
+        let path = std::env::var("LUMENDSH_PREPARED_TEXT").map_err(|e| GSVError::from(e.to_string()))?;
+        let prepared: PreparedText = serde_json::from_slice(&std::fs::read(path)?)
