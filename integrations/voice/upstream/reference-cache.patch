+    /// Read a desktop-prepared cache without loading SSL, SV or the reference encoder.
+    pub fn from_reference_cache(root: &Path, cache: &Path) -> Result<Self, GSVError> {
+        let bytes = std::fs::read(cache)?;
+        if bytes.len() > 32 * 1024 * 1024 {
+            return Err("Reference cache exceeds 32 MiB".into());
+        }
+        let envelope: serde_json::Value =
+            serde_json::from_slice(&bytes).map_err(|e| GSVError::from(e.to_string()))?;
+        if envelope["schemaVersion"] != 1 {
+            return Err("Unsupported reference cache".into());
+        }
+        let data: ReferenceData = serde_json::from_value(envelope["reference"].clone())
+            .map_err(|e| GSVError::from(e.to_string()))?;
+        if data.ref_seq.nrows() != 1
+            || data.ref_seq.is_empty()
+            || data.prompts.nrows() != 1
+            || data.prompts.is_empty()
+            || data.ref_bert.nrows() != data.ref_seq.ncols()
+            || data.ref_bert.ncols() != 1024
+            || data.ref_audio_32k.nrows() != 1
+        {
+            return Err("Invalid reference tensor dimensions".into());
+        }
+        let mut model = Self::new_internal(
+            root.join("vits.onnx"),
+            root.join("ssl.onnx"),
+            root.join("t2s_encoder.onnx"),
+            root.join("t2s_fs_decoder.onnx"),
+            root.join("t2s_s_decoder.onnx"),
+            Some(root.join("bert.onnx")),
+            Some(root.join("g2pW.onnx")),
